# ─── Clerk Authentication (web + mobile) ────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=server-side-only
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here

# ─── Convex Backend ────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=deploy-key-for-ci-only
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Issuer domain used by convex/auth.config.ts (set via `npx convex env set`)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ─── Cashfree Payment Gateway (Convex actions; set in dashboard) ─
# CASHFREE_APP_ID / CASHFREE_SECRET_KEY are secrets: set them with
# `npx convex env set` — never commit them.
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
CASHFREE_RETURN_URL=https://your-web-app/booking/status
