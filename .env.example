# ============================================================
# CtrlPass — Environment variables template
# Copy to .env.local and fill in your credentials.
# ============================================================

# --- TMDB (movie metadata) ---
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex backend ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=


# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin access ---
# Comma-separated email list that gets the admin role
ADMIN_EMAILS=
CRON_SECRET=
