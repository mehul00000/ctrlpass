# Clerk Authentication (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex Backend (https://dashboard.convex.dev)
NEXT_PUBLIC_CONVEX_URL=

# Cashfree Sandbox / Production (read server-side in Convex actions; set via `npx convex env set`)
CASHFREE_ENV=TEST
NEXT_PUBLIC_CASHFREE_ENV=sandbox
